# PostgreSQL database (use Render's Internal Database URL when deployed
# on Render in the same region, otherwise the External Database URL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Express session
SESSION_SECRET=

# Google Generative AI (Gemini) - evaluateController.js
GEMINI_API_KEY=

# Infura IPFS - ipfsService.js
INFURA_PROJECT_ID=
INFURA_PROJECT_SECRET=

# Brevo transactional email (OTP delivery) - server.js
# Render blocks outbound raw SMTP, so email is sent via Brevo's HTTPS API instead.
# Sign up at brevo.com, verify a sender email under Senders, then create an API key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Google OAuth (passport-google-oauth2) - server.js
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Environment
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
# (falls back to https://tasc-so9j.onrender.com if unset)
CORS_ORIGIN=http://localhost:3000,https://tasc-so9j.onrender.com
